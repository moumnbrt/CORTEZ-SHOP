# إعدادات general
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=ضع_هنا_نصا_عشوائيا_طويلا

# تطبيق ديسكورد (Discord Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# السيرفر والرول
DISCORD_GUILD_ID=
# معرّف الرول الذي يسمح بالدخول (يُفضّل استخدامه). يمكنك وضع أكثر من معرّف مفصول بفاصلة.
DISCORD_SHOP_ROLE_IDS=
# إن لم تضع معرّف الرول، ضع توكن بوت موجود في السيرفر للمطابقة بالاسم.
DISCORD_BOT_TOKEN=
DISCORD_SHOP_ROLE_NAME=شوب

# معرّفات أدمن ديسكورد (مفصولة بفاصلة) - لهم حق إضافة وتعديل المنتجات
ADMIN_DISCORD_IDS=

# رابط الدعوة لسيرفر ديسكورد (اختياري)
DISCORD_INVITE_URL=

# ويبهوك روم ديسكورد اللي كيستقبل تنبيهات الطلبات (اختياري)
DISCORD_ORDER_WEBHOOK_URL=

# معاينة المنظور محلياً فقط: /auth/preview?as=member|admin|denied (معطّلة فالإنتاج)
PREVIEW_MODE=false

# وضع تجريبي: تسجيل دخول وهمي بالصلاحيات الكاملة لتجربة الموقع بدون بيانات ديسكورد.
# يُفعّل تلقائياً في التطوير إن لم تُضبط بيانات OAuth. لا تفعّله في الإنتاج.
DEMO_MODE=false
